ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-haiku-4-5.
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional. Leave unset to keep deep mode on the same model as normal mode.
# MODEL_DEEP=
DATABASE_URL=./data/learn.db
# Optional: hard cap on concurrent model calls.
AI_CONCURRENCY=3
# Optional: point the SDK at a compatible gateway or a local fake server.
# ANTHROPIC_BASE_URL=http://localhost:9090
